---
/**
 * Punjabi (Shahmukhi) text, marked lang="pnb" dir="rtl" so it gets the Nastaliq
 * face and right-to-left layout even on English pages.
 *
 * <Pa t={poem.title} />            → one span
 * <Pa t={verse} as="p" lines />    → paragraph, "\n" → line spans
 */
import { PA_LANG } from '~/i18n';

interface Props {
  t: string;
  as?: 'span' | 'p' | 'div' | 'li';
  lines?: boolean;
  class?: string;
}
const { t, as: Tag = 'span', lines = false, class: className } = Astro.props;
---
<Tag lang={PA_LANG} dir="rtl" class={className}>{lines ? t.split('\n').map((line) => <span class="line">{line}</span>) : t}</Tag>
