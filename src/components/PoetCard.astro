---
/** Poet card for grids (home, /poets). Portrait or an honest letter tile. */
import { Image } from 'astro:assets';
import Pa from './Pa.astro';
import T from './T.astro';
import { asLocale, localePath } from '~/i18n';
import { lifespan, type Poet } from '~/lib/content';
import { lifespanPa, STYLE_PA } from '~/lib/pa';
import type { UIKey } from '~/i18n/ui';

/** priority: the card is in the first row, so its image loads eagerly (it is often the LCP). */
interface Props { poet: Poet; compact?: boolean; priority?: boolean }
const { poet, compact = false, priority = false } = Astro.props;
const d = poet.data;
const locale = asLocale(Astro.currentLocale);
const en = locale === 'en';
const initial = new Intl.Segmenter().segment(d.name.pa)[Symbol.iterator]().next().value?.segment ?? '';
const dates = en ? lifespan(d) : lifespanPa(d);
---
<article class="poet-tile" data-filter-item data-era={d.era} data-filter-text={(en ? `${d.name.en} ${d.name.pa}` : d.name.pa).toLowerCase()}>
  <a class="poet-tile__link" href={localePath(locale, `/poets/${poet.id}`)}>
    {d.portrait ? (
      <Image src={d.portrait} alt="" widths={[200, 320, 420]} sizes="(min-width: 56rem) 15rem, 45vw" class="poet-tile__img" quality={50} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
    ) : (
      <span class="poet-tile__none" aria-hidden="true"><span lang="pnb">{initial}</span></span>
    )}
    <span class="poet-tile__pa"><Pa t={d.name.pa} /></span>
    {en && <span class="poet-tile__en">{d.name.en}</span>}
  </a>
  {dates && <p class="poet-tile__dates muted">{en ? <bdi dir="ltr">{dates}</bdi> : <bdi>{dates}</bdi>}</p>}
  {!compact && (
    <>
      <p class="poet-tile__caption muted">
        {d.portrait ? (en ? <bdi lang="en">{d.portrait_caption}</bdi> : <bdi>{d.portrait_caption_pa}</bdi>) : <T k="poet.noPortrait" />}
      </p>
      <p class="poet-tile__tags">
        <span class="tag tag--accent"><T k={`era.${d.era}` as UIKey} /></span>
        {d.styles.filter((s) => s.toLowerCase() !== d.era).slice(0, 2).map((s) => (en ? <span class="tag" lang="en" dir="ltr">{s}</span> : <span class="tag">{STYLE_PA[s] ?? s}</span>))}
      </p>
      {en ? <p class="poet-tile__bio" lang="en" dir="ltr">{d.bio_short}</p> : d.bio_short_pa && <p class="poet-tile__bio">{d.bio_short_pa}</p>}
    </>
  )}
</article>
