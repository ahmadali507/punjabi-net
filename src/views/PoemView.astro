---
/**
 * Poem reader, shared by /poems/{slug} and /pa/poems/{slug}.
 * The poem text is the largest thing on the page. Glossed words are wrapped at
 * build time; JavaScript only opens meanings and runs the reading tools.
 */
import Base from '~/layouts/Base.astro';
import Pa from '~/components/Pa.astro';
import T from '~/components/T.astro';
import Source from '~/components/Source.astro';
import WordCard from '~/components/WordCard.astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { asLocale, localePath, t, PA_LANG } from '~/i18n';
import type { UIKey } from '~/i18n/ui';
import { lifespanPa, verificationPa } from '~/lib/pa';
import { lifespan, paDigits, poemsByPoet, poemsOfWork, segmentLine, wordMeanings, type Poem } from '~/lib/content';
import { POS } from '~/content.config';
import { abs, ids, type Crumb } from '~/lib/seo';
import '~/styles/reader.css';
import '~/styles/work.css';

interface Props { poem: Poem }
const { poem } = Astro.props;
const d = poem.data;
const locale = asLocale(Astro.currentLocale);
const en = locale === 'en';

const poet = (await getEntry(d.poet))!;
const form = (await getEntry(d.form))!;
const more = (await poemsByPoet(poet.id)).filter((p) => p.id !== poem.id && (!d.work || p.data.work?.id.id !== d.work.id.id)).slice(0, 6);
// A part of a qissa, book or collection: where it sits, and its neighbours.
const work = d.work ? (await getEntry(d.work.id))! : undefined;
const siblings = d.work ? await poemsOfWork(d.work.id.id) : [];
const at = siblings.findIndex((p) => p.id === poem.id);
const prevPart = at > 0 ? siblings[at - 1] : undefined;
const nextPart = at >= 0 && at < siblings.length - 1 ? siblings[at + 1] : undefined;
const { Content } = await render(poem);
const hasNotes = Boolean(poem.body?.trim());
const { items: gloss, lookup } = await wordMeanings(poem, (id) => localePath(locale, `/dictionary/${id}`), locale);
// Part-of-speech labels in the page's language, for the meaning card.
const posLabels = Object.fromEntries([...POS.map((p) => [p, t(locale, `pos.${p}` as UIKey)]), ['proper noun', t(locale, 'pos.proper')]]);
const hasText = d.verses.length > 0;
const dates = en ? lifespan(poet.data) : lifespanPa(poet.data);

const pageTitle = en ? `${d.title_en ?? d.title} · ${poet.data.name.en}` : `${d.title} · ${poet.data.name.pa}`;
const description: string = !en
  ? `${form.data.name.pa}، ${poet.data.name.pa}${hasText ? '' : '۔ متن حالے چڑھایا نہیں گیا'}۔`
  : hasText
  ? `${d.title_en ? `${d.title_en} (${d.title})` : d.title}: ${/^[aeiou]/i.test(form.data.name.en) ? 'an' : 'a'} ${form.data.name.en.toLowerCase()} by ${poet.data.name.en}${dates ? ` (${dates})` : ''}${work ? `, from ${work.data.title_en}` : ''}. Full text in Shahmukhi${d.translation ? ' with an English translation' : ''}, with word meanings.`
  : `${form.data.name.en} by ${poet.data.name.en}. Text not yet entered.`;
// The poem itself, as text answer engines can quote (capped so very long parts stay light).
const site = Astro.site!;
// Search indexes English pages only (the /pa search reads the same index), and a work's parts are
// found through the work page, which holds their text: this keeps the build under the host's file limit.
const indexed = en && !d.work;
const fullText = d.verses.map((v) => v.text).join('\n\n');
const enText = d.translation ? d.verses.map((v) => v.en ?? '').filter(Boolean).join('\n\n') : '';
const cap = (s: string) => (s.length > 6000 ? `${s.slice(0, 6000).replace(/\s+\S*$/, '')} …` : s);
const jsonLd = {
  '@type': 'CreativeWork',
  '@id': ids.poem(site, poem.id),
  name: d.title,
  alternateName: d.title_en,
  headline: d.title_en ? `${d.title} (${d.title_en})` : d.title,
  description,
  url: abs(site, localePath(locale, `/poems/${poem.id}`)),
  inLanguage: 'pnb',
  genre: form.data.name.en,
  text: hasText ? cap(fullText) : undefined,
  author: {
    '@type': 'Person',
    '@id': ids.poet(site, poet.id),
    name: poet.data.name.en,
    alternateName: poet.data.name.pa,
    url: abs(site, `/poets/${poet.id}`),
  },
  isPartOf: work && d.work ? { '@type': 'Book', '@id': ids.work(site, work.id), name: work.data.title, alternateName: work.data.title_en, url: abs(site, `/works/${work.id}`) } : undefined,
  position: d.work?.n,
  isBasedOn: { '@type': 'Book', name: d.source.book, editor: d.source.editor, publisher: d.source.publisher, url: d.source.url },
  workTranslation: enText ? { '@type': 'CreativeWork', inLanguage: 'en', text: cap(enText), translator: { '@type': 'Person', name: d.translation!.translator } } : undefined,
  license: poet.data.copyright_status === 'public_domain' ? 'https://creativecommons.org/publicdomain/mark/1.0/' : undefined,
  isAccessibleForFree: true,
  publisher: { '@id': ids.org(site) },
};
const crumbs: Crumb[] = [
  { name: t(locale, 'nav.poets'), path: localePath(locale, '/poets') },
  { name: en ? poet.data.name.en : poet.data.name.pa, path: localePath(locale, `/poets/${poet.id}`) },
  ...(work ? [{ name: en ? work.data.title_en : work.data.title, path: localePath(locale, `/works/${work.id}`) }] : []),
  { name: en ? (d.title_en ?? d.title) : d.title, path: localePath(locale, `/poems/${poem.id}`) },
];
// Stanza numbers skip refrain repeats: a kafi's refrain is labelled, not counted.
const stanzaNo = d.verses.map((v, i) => (v.refrain ? 0 : d.verses.slice(0, i + 1).filter((x) => !x.refrain).length));
const num = (n: number) => (en ? String(n) : paDigits(n));
---
<Base title={pageTitle} description={description} type="article" jsonLd={jsonLd} crumbs={crumbs} noindex={!hasText} preloadNastaliq>
  <article class="poem" data-pagefind-body={indexed || undefined} data-pagefind-filter="type:poem" data-pagefind-meta={`title:${d.title}${en && d.title_en ? ` · ${d.title_en}` : ''}`}>
    {en && <meta data-pagefind-meta="pa[content]" content={d.title} />}
    {work && d.work && (
      <nav class="column no-print" aria-label={t(locale, 'work.partOf')} data-pagefind-ignore>
        <div class="in-work">
          <span>
            <T k="work.partOf" />{' '}
            <a href={localePath(locale, `/works/${work.id}`)}>{en ? <>{work.data.title_en} (<Pa t={work.data.title} />)</> : <Pa t={work.data.title} />}</a>
            {' · '}{num(d.work.n)} <T k="work.of" /> {num(siblings.length)}
            {d.work.chapter && <> · <Pa t={d.work.chapter} /></>}
          </span>
          <span class="in-work__nav">
            {prevPart && <a class="button" href={localePath(locale, `/poems/${prevPart.id}`)} rel="prev">{en ? '‹' : '›'} {num(prevPart.data.work!.n)}</a>}
            <a class="button" href={localePath(locale, `/works/${work.id}#p-${d.work.n}`)}><T k="work.readWhole" /></a>
            {nextPart && <a class="button" href={localePath(locale, `/poems/${nextPart.id}`)} rel="next">{num(nextPart.data.work!.n)} {en ? '›' : '‹'}</a>}
          </span>
        </div>
      </nav>
    )}
    <header class="column poem__head">
      <p class="eyebrow">
        <a href={localePath(locale, `/forms/${form.id}`)}>{en ? form.data.name.en : form.data.name.pa}</a>
      </p>
      <h1 class="poem__title"><Pa t={d.title} /></h1>
      {en && d.title_en && <p class="poem__title-en">{d.title_en}</p>}
      <p class="poem__poet">
        <a href={localePath(locale, `/poets/${poet.id}`)}>{en ? poet.data.name.en : poet.data.name.pa}</a>
        {dates && <span class="muted"> · {en ? <bdi dir="ltr">{dates}</bdi> : <bdi>{dates}</bdi>}</span>}
      </p>
    </header>

    {hasText ? (
      <div class="poem__body">
        <div class="column reader-tools no-print" data-reader-tools data-pagefind-ignore hidden>
          <div class="reader-tools__group" role="group" aria-label={t(locale, 'reader.tools')}>
            {gloss.length > 0 && (
              <button type="button" class="tool tool--meanings" data-meanings aria-pressed="true">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H12v17H6.5A2.5 2.5 0 0 0 4 22.5zM20 5.5A2.5 2.5 0 0 0 17.5 3H12v17h5.5a2.5 2.5 0 0 1 2.5 2.5z" /></svg>
                <T k="reader.meanings" />
              </button>
            )}
            {gloss.length > 0 && <span class="tools-sep" aria-hidden="true"></span>}
            <button type="button" class="tool" data-size="-1" aria-label={t(locale, 'reader.smaller')}>{en ? 'A−' : 'ا−'}</button>
            <button type="button" class="tool" data-size="1" aria-label={t(locale, 'reader.larger')}>{en ? 'A+' : 'ا+'}</button>
            <button type="button" class="tool" data-copy><T k="reader.copy" /></button>
            <button type="button" class="tool" data-print><T k="reader.print" /></button>
            <button type="button" class="tool" data-share><T k="reader.share" /></button>
          </div>
          <span class="reader-tools__status" role="status" aria-live="polite" data-copied={t(locale, 'reader.copied')} data-link-copied={t(locale, 'reader.linkCopied')}></span>
        </div>


        <ol class:list={['verses', { 'verses--long': d.verses.length > 6 }]} data-verses data-title={d.title} data-poet={en ? poet.data.name.en : poet.data.name.pa}>
          {d.verses.map((v, i) => (
            <li class:list={['verse', { 'verse--refrain': v.refrain }]}>
              <span class="verse__n">
                {v.refrain ? (
                  <span class="verse__refrain"><T k="reader.refrain" /></span>
                ) : (
                  <><span class="visually-hidden"><T k="reader.verse" /> </span>{num(stanzaNo[i])}</>
                )}
              </span>
              <p class="verse__text" lang={PA_LANG} dir="rtl">
                {v.text.split('\n').map((line) => (
                  <span class="line">
                    {segmentLine(line, lookup).map((seg) =>
                      seg.g === undefined ? seg.text : <button type="button" class="w" data-g={seg.g} tabindex="-1">{seg.text}</button>,
                    )}
                  </span>
                ))}
              </p>
              {en && v.en && (
                <p class="verse__en" lang="en" dir="ltr">
                  {v.en.split('\n').map((line) => <span class="line">{line}</span>)}
                </p>
              )}
            </li>
          ))}
        </ol>

        {gloss.length > 0 && <WordCard />}
        {gloss.length > 0 && <script type="application/json" id="gloss-data" set:html={JSON.stringify({ items: gloss, pos: posLabels, base: t(locale, 'gloss.base'), guess: t(locale, 'gloss.guess') }).replace(/</g, '\\u003c')} />}
      </div>
    ) : (
      <section class="column poem__pending">
        <h2><T k="poem.textNeeded.title" /></h2>
        <p><T k="poem.textNeeded.body" /></p>
        <p><a class="button" href={localePath(locale, '/about#contribute')}><T k="nav.contribute" /></a></p>
      </section>
    )}

    <div class="column poem__after">
      {en && d.translation && (
        <p class="muted poem__translator">
          <T k="poem.translation" />: <bdi lang="en">{d.translation.translator}</bdi>
          {d.translation.source && <>, <Source source={d.translation.source} /></>}
        </p>
      )}

      {en && hasNotes && (
        <section class="poem__notes">
          <h2><T k="poem.notes" /></h2>
          <div class="prose" lang="en" dir="ltr"><Content /></div>
        </section>
      )}

      <dl class="poem__meta" data-pagefind-ignore>
        <div><dt><T k="poem.source" /></dt><dd><Source source={d.source} /></dd></div>
        {en ? (
          <div><dt><T k="poem.verification" /></dt><dd lang="en" dir="ltr">{d.verification_note}</dd></div>
        ) : (
          <div><dt><T k="poem.verification" /></dt><dd>{verificationPa(d.verification_note)}</dd></div>
        )}
      </dl>

      <aside class="poet-card no-print" aria-labelledby="about-poet" data-pagefind-ignore>
        <h2 class="eyebrow" id="about-poet"><T k="poem.aboutPoet" /></h2>
        {poet.data.portrait && <Image src={poet.data.portrait} alt="" width={128} class="poet-card__img" />}
        <p class="poet-card__name">
          <a href={localePath(locale, `/poets/${poet.id}`)}>{en ? poet.data.name.en : poet.data.name.pa}</a>
          {en && <>{' '}<Pa t={poet.data.name.pa} class="poet-card__pa" /></>}
          {dates && <span class="muted"> · {en ? <bdi dir="ltr">{dates}</bdi> : <bdi>{dates}</bdi>}</span>}
        </p>
        {en ? <p lang="en" dir="ltr">{poet.data.bio_short}</p> : poet.data.bio_short_pa && <p>{poet.data.bio_short_pa}</p>}
      </aside>

      {more.length > 0 && (
        <section class="more no-print" aria-labelledby="more-poet" data-pagefind-ignore>
          <h2 class="eyebrow" id="more-poet"><T k="poem.morePoet" /></h2>
          <ul class="poem-list">
            {more.map((p) => (
              <li>
                <a href={localePath(locale, `/poems/${p.id}`)}><Pa t={p.data.title} /></a>
                {en && p.data.title_en && <span class="muted" lang="en"> {p.data.title_en}</span>}
                {p.data.verses.length === 0 && <span class="badge"><T k="poem.textPending" /></span>}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</Base>

<script>
  import { initReader } from '~/scripts/reader';
  import { initGlossary } from '~/scripts/glossary';
  initReader();
  initGlossary();
</script>
