---
/** /proverbs/{slug}: one proverb with its literal and idiomatic meaning, usage and source. */
import Base from '~/layouts/Base.astro';
import Pa from '~/components/Pa.astro';
import T from '~/components/T.astro';
import Source from '~/components/Source.astro';
import { asLocale, localePath, t, tf } from '~/i18n';
import { getProverbs, type Proverb } from '~/lib/content';
import { TOPIC_PA } from '~/lib/pa';
import { abs } from '~/lib/seo';
import '~/styles/lists.css';
import '~/styles/reader.css';

interface Props { proverb: Proverb }
const { proverb } = Astro.props;
const d = proverb.data;
const locale = asLocale(Astro.currentLocale);
const all = await getProverbs();
const i = all.findIndex((p) => p.id === proverb.id);
const prev = all[i - 1];
const next = all[i + 1];
const en = locale === 'en';
// Punjabi pages: the proverb, its Punjabi explanation and the source, nothing in English.
// English titles: the proverb's literal sense, without trailing punctuation; the Shahmukhi leads the description.
const literal = d.literal_en.replace(/\s+/g, ' ').replace(/[\s,;:]+$/, '');
const title = en ? literal : d.text;
const description = en
  ? `Punjabi proverb ${d.text.replace(/\s+/g, ' ')}${d.romanized ? ` (${d.romanized.replace(/\s+/g, ' ')})` : ''}: “${literal}”${d.meaning_en ? `. Meaning: ${d.meaning_en.replace(/\s+/g, ' ')}` : ''}`
  : (d.meaning_pa ?? d.text);
const site = Astro.site!;
const jsonLd = {
  '@type': 'Quotation',
  '@id': abs(site, `/proverbs/${proverb.id}#proverb`),
  name: d.text,
  text: d.text,
  alternateName: d.romanized,
  inLanguage: 'pnb',
  genre: 'Proverb',
  description: [d.literal_en, d.meaning_en].filter(Boolean).join(' — '),
  url: abs(site, localePath(locale, `/proverbs/${proverb.id}`)),
  image: abs(site, `/og/proverbs/${proverb.id}.png`),
};
const crumbs = [
  { name: t(locale, 'nav.proverbs'), path: localePath(locale, '/proverbs') },
  { name: en ? d.literal_en : d.text, path: localePath(locale, `/proverbs/${proverb.id}`) },
];
---
<Base title={title} description={description} type="article" image={`/og/proverbs/${proverb.id}.png`} jsonLd={jsonLd} crumbs={crumbs} preloadNastaliq>
  <article class="column section proverb" data-pagefind-body data-pagefind-filter="type:proverb" data-pagefind-meta={`title:${d.text}`}>
    <p class="eyebrow">
      <a href={localePath(locale, '/proverbs')}><T k="nav.proverbs" /></a> · <span data-pagefind-ignore>{tf(locale, 'proverbs.position', { i: i + 1, n: all.length })}</span>
    </p>
    <h1 class="proverb__text"><Pa t={d.text} /></h1>
    {en && d.romanized && <p class="muted proverb__roman" lang="pa-Latn" dir="ltr"><i>{d.romanized.split('\n').map((l) => <span class="line">{l}</span>)}</i></p>}

    <div class="reader-tools no-print" data-pagefind-ignore data-share-tools data-copy-text={en ? `${d.text}\n${d.literal_en}` : `${d.text}\n${d.meaning_pa ?? ''}`.trim()} hidden>
      <div class="reader-tools__group">
        <button type="button" class="tool" data-copy><T k="reader.copy" /></button>
        <button type="button" class="tool" data-share><T k="reader.share" /></button>
      </div>
      <span class="reader-tools__status" role="status" aria-live="polite" data-copied={t(locale, 'reader.copied')} data-link-copied={t(locale, 'reader.linkCopied')}></span>
    </div>

    {en ? (
      <dl class="proverb-meta">
        <div><dt data-pagefind-ignore><T k="proverbs.literal" /></dt><dd lang="en" dir="ltr">{d.literal_en}</dd></div>
        {d.meaning_en && <div><dt data-pagefind-ignore><T k="proverbs.meaning" /></dt><dd lang="en" dir="ltr">{d.meaning_en}</dd></div>}
        {d.usage_note && <div><dt data-pagefind-ignore><T k="proverbs.usage" /></dt><dd lang="en" dir="ltr">{d.usage_note}</dd></div>}
        {d.topic && <div><dt data-pagefind-ignore><T k="proverbs.topic" /></dt><dd lang="en" dir="ltr">{d.topic}</dd></div>}
        <div data-pagefind-ignore><dt><T k="poem.source" /></dt><dd><Source source={d.source} /></dd></div>
      </dl>
    ) : (
      <dl class="proverb-meta">
        {d.meaning_pa && <div><dt data-pagefind-ignore><T k="proverbs.meaning" /></dt><dd>{d.meaning_pa}</dd></div>}
        {d.usage_pa && <div><dt data-pagefind-ignore><T k="proverbs.usage" /></dt><dd>{d.usage_pa}</dd></div>}
        {d.topic && TOPIC_PA[d.topic] && <div><dt data-pagefind-ignore><T k="proverbs.topic" /></dt><dd>{TOPIC_PA[d.topic]}</dd></div>}
        <div data-pagefind-ignore><dt><T k="poem.source" /></dt><dd><Source source={d.source} /></dd></div>
      </dl>
    )}

    {d.transliterated && <p class="notice" style="text-align:start"><T k="proverbs.translit" /></p>}

    <nav class="pager no-print" data-pagefind-ignore>
      {prev ? <a href={localePath(locale, `/proverbs/${prev.id}`)} rel="prev"><T k="proverbs.prev" /></a> : <span></span>}
      {next ? <a href={localePath(locale, `/proverbs/${next.id}`)} rel="next"><T k="proverbs.next" /></a> : <span></span>}
    </nav>
  </article>
</Base>

<script>
  import { initShare } from '~/scripts/share';
  initShare();
</script>
