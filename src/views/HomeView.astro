---
/**
 * Home: thesis, intro, buttons; recommended poets; selected poems; a proverb;
 * closing couplet in the footer (only when SITE.footerCouplet points at a verse that exists).
 */
import Base from '~/layouts/Base.astro';
import Pa from '~/components/Pa.astro';
import T from '~/components/T.astro';
import PoetCard from '~/components/PoetCard.astro';
import PoemRow from '~/components/PoemRow.astro';
import { getEntry } from 'astro:content';
import { ui } from '~/i18n/ui';
import { asLocale, localePath } from '~/i18n';
import { SITE } from '~/site.config';
import { getForms, getPoems, getPoets, getProverbs } from '~/lib/content';
import '~/styles/lists.css';

const locale = asLocale(Astro.currentLocale);
const en = locale === 'en';
const thesis = ui['home.thesis'];
const [poets, poems, forms, proverbs] = await Promise.all([getPoets(), getPoems(), getForms(), getProverbs()]);
const poetById = new Map(poets.map((p) => [p.id, p]));
const formById = new Map(forms.map((f) => [f.id, f]));

const recommended = poets.filter((p) => p.data.recommended).slice(0, 4);
// Featured poems first, then poems with text, then the rest; four in all.
const selected = [...poems]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || Number(b.data.verses.length > 0) - Number(a.data.verses.length > 0))
  .slice(0, 4);
// A proverb that changes with each build day, so the page is static but not frozen.
const day = Math.floor(Date.now() / 86_400_000);
const proverb = proverbs.length ? proverbs[day % proverbs.length] : undefined;

let couplet: { text: string; poet: string; href: string } | undefined;
if (SITE.footerCouplet) {
  const poem = await getEntry('poems', SITE.footerCouplet.poem);
  const verse = poem?.data.verses[SITE.footerCouplet.verse];
  if (poem && verse) {
    const poet = poetById.get(poem.data.poet.id);
    couplet = { text: verse.text, poet: (en ? poet?.data.name.en : poet?.data.name.pa) ?? '', href: localePath(locale, `/poems/${poem.id}`) };
  }
}
---
<Base jsonLd={{ '@type': 'WebSite', name: SITE.name, url: Astro.site?.href, inLanguage: ['en', 'pnb'], description: SITE.description }}>
  <section class="home-hero">
    <!-- Decoration only: ruled lines, a large faint پنجابی and a few diamonds (CSS, no JS). -->
    <span class="home-hero__mark" lang="pnb" dir="rtl" aria-hidden="true">پنجابی</span>
    <span class="home-hero__diamond home-hero__diamond--1" aria-hidden="true"></span>
    <span class="home-hero__diamond home-hero__diamond--2" aria-hidden="true"></span>
    <span class="home-hero__diamond home-hero__diamond--3" aria-hidden="true"></span>
    <div class="home-hero__inner">
      <h1 class="home-hero__title">{en ? ui['home.headline'].en : <Pa t={ui['home.headline'].pa} />}</h1>
      <p class="home-hero__thesis"><Pa t={thesis.pa} /></p>
      {en && <p class="home-hero__en" lang="en" dir="ltr">{thesis.en}</p>}
      <p class="home-hero__intro"><T k="home.intro" /></p>
      <div class="button-row">
        <a class="button button--primary button--lg" href={localePath(locale, '/poems')}><T k="home.explore" /></a>
        <a class="home-hero__link" href={localePath(locale, '/poets')}><T k="home.meet" /> <span aria-hidden="true">{en ? '→' : '←'}</span></a>
      </div>
    </div>
  </section>

  {recommended.length > 0 && (
    <section class="wrap home-block" aria-labelledby="h-poets">
      <div class="block-head">
        <h2 id="h-poets"><T k="home.recommended" /></h2>
        <a href={localePath(locale, '/poets')}><T k="home.allPoets" /></a>
      </div>
      <div class="poet-grid">{recommended.map((p, i) => <PoetCard poet={p} compact priority={i === 0} />)}</div>
    </section>
  )}

  {selected.length > 0 && (
    <section class="wrap home-block" aria-labelledby="h-poems">
      <div class="block-head">
        <h2 id="h-poems"><T k="home.selected" /></h2>
        <a href={localePath(locale, '/poems')}><T k="home.allPoems" /></a>
      </div>
      <ul class="poem-rows">
        {selected.map((p) => <PoemRow poem={p} poet={poetById.get(p.data.poet.id)} form={formById.get(p.data.form.id)} />)}
      </ul>
    </section>
  )}

  {proverb && (
    <section class="column home-block" aria-labelledby="h-proverb">
      <div class="home-proverb">
        <h2 id="h-proverb" class="eyebrow"><T k="home.proverb" /></h2>
        <a class="home-proverb__text" href={localePath(locale, `/proverbs/${proverb.id}`)}><Pa t={proverb.data.text} /></a>
        <p class="muted" lang="en" dir="ltr">{proverb.data.meaning_en ?? proverb.data.literal_en.replace(/\n/g, ' ')}</p>
      </div>
    </section>
  )}

  {couplet && (
    <figure class="couplet" slot="couplet">
      <blockquote><Pa t={couplet.text} as="p" lines /></blockquote>
      <figcaption><a href={couplet.href}>{couplet.poet}</a></figcaption>
    </figure>
  )}
</Base>

<style>
  /* ---------- Hero: ruled paper, faint watermark, diamonds ---------- */
  .home-hero {
    --rule-gap: 2.4rem;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4rem, 2.5rem + 7vw, 8.5rem) var(--gutter) clamp(3.5rem, 2.5rem + 4vw, 6rem);
    text-align: center;
    border-bottom: 1px solid var(--rule);
    background:
      radial-gradient(ellipse 60% 55% at 25% 62%, color-mix(in oklab, var(--accent) 9%, transparent), transparent 70%),
      radial-gradient(ellipse 45% 40% at 85% 20%, color-mix(in oklab, var(--accent) 6%, transparent), transparent 70%),
      repeating-linear-gradient(to bottom, transparent 0 calc(var(--rule-gap) - 1px), color-mix(in oklab, var(--ink) 6%, transparent) calc(var(--rule-gap) - 1px) var(--rule-gap)),
      var(--paper);
  }
  /* Fade the ruled lines out towards the bottom edge. */
  .home-hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--paper));
    z-index: -1;
  }
  .home-hero__mark {
    position: absolute;
    z-index: -2;
    left: -3%;
    top: 34%;
    font-family: var(--font-sm);
    font-size: clamp(9rem, 4rem + 26vw, 28rem);
    line-height: 1;
    color: color-mix(in oklab, var(--accent) 11%, transparent);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }
  .home-hero__diamond {
    position: absolute;
    z-index: -1;
    width: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    aspect-ratio: 1;
    rotate: 45deg;
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    border-radius: 3px;
    pointer-events: none;
  }
  .home-hero__diamond--1 { left: 22%; top: 46%; }
  .home-hero__diamond--2 { left: 27%; top: 38%; width: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .home-hero__diamond--3 { right: 14%; bottom: 14%; }
  .home-hero__inner { max-width: 56rem; margin-inline: auto; }

  .home-hero__title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.7rem, 1.2rem + 6.5vw, 6.6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 13ch;
    margin: 0 auto 1.5rem;
    text-wrap: balance;
  }
  html[lang='pnb'] .home-hero__title { max-width: none; letter-spacing: 0; line-height: 1.6; font-size: clamp(2.6rem, 1.4rem + 5vw, 5.4rem); }
  .home-hero__thesis { margin: 0 auto 0.5rem; color: var(--accent); font-size: clamp(1.35rem, 1.1rem + 1.2vw, 2rem); }
  .home-hero__thesis :global(:lang(pnb)) { line-height: 2; }
  .home-hero__en {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    color: var(--muted);
    margin: 0 auto 1.25rem;
  }
  .home-hero__intro {
    max-width: 36rem;
    margin: 1rem auto 2.25rem;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.75;
    color: var(--muted);
  }
  html[lang='pnb'] .home-hero__intro { font-family: var(--font-sm); line-height: 2.2; }
  .button-row { justify-content: center; align-items: center; gap: 1.5rem; }
  .button--lg { min-height: 3.25rem; padding-inline: 1.6rem; font-size: 1.05rem; border-radius: 2px; }
  .home-hero__link { color: var(--accent); font-size: 1.05rem; font-weight: 500; text-decoration: none; }
  .home-hero__link:hover { text-decoration: underline; }
  .home-hero__link span { display: inline-block; transition: translate 0.2s; }
  .home-hero__link:hover span { translate: 0.25em 0; }
  html[lang='pnb'] .home-hero__link:hover span { translate: -0.25em 0; }
  @media (prefers-reduced-motion: reduce) { .home-hero__link span { transition: none; } }
  @media (max-width: 40rem) {
    .home-hero__mark { top: 52%; left: -12%; }
    .home-hero__diamond--1, .home-hero__diamond--2 { left: 6%; }
  }
  @media print { .home-hero__mark, .home-hero__diamond { display: none; } .home-hero { background: none; } }

  .couplet blockquote { margin: 0 0 0.5rem; }
  .couplet figcaption { font-size: 0.95rem; color: var(--muted); }
</style>
