---
/**
 * Home. Phase 1 has the thesis, intro and the two buttons only.
 * Recommended poets, selected poems and the footer couplet arrive in phase 3.
 */
import Base from '~/layouts/Base.astro';
import Pa from '~/components/Pa.astro';
import T from '~/components/T.astro';
import { ui } from '~/i18n/ui';
import { asLocale, localePath } from '~/i18n';

const locale = asLocale(Astro.currentLocale);
const thesis = ui['home.thesis'];
---
<Base>
  <section class="column section home-hero">
    <h1 class="home-hero__thesis">
      <Pa t={thesis.pa} />
      {locale === 'en' && <span class="home-hero__en" lang="en" dir="ltr">{thesis.en}</span>}
    </h1>
    <p class="home-hero__intro"><T k="home.intro" /></p>
    <div class="button-row">
      <a class="button button--primary" href={localePath(locale, '/poems')}><T k="home.explore" /></a>
      <a class="button" href={localePath(locale, '/poets')}><T k="home.meet" /></a>
    </div>
  </section>
</Base>

<style>
  .home-hero { text-align: center; padding-block-start: clamp(3rem, 2rem + 6vw, 6rem); }
  .home-hero__thesis { display: flex; flex-direction: column; gap: 0.75rem; font-weight: 400; }
  .home-hero__thesis :global(:lang(pnb)) { font-size: clamp(1.7rem, 1.3rem + 2vw, 2.4rem); }
  .home-hero__thesis :global(:lang(pnb)) { line-height: 2.1; }
  .home-hero__en {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.35rem);
    font-style: italic;
    color: var(--muted);
    line-height: 1.4;
  }
  .home-hero__intro { max-width: 34rem; margin: 1.5rem auto 2rem; color: var(--muted); }
  .button-row { justify-content: center; }
</style>
