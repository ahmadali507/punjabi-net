---
/** /proverbs: numbered list with search (Shahmukhi or English). */
import Base from '~/layouts/Base.astro';
import Pa from '~/components/Pa.astro';
import T from '~/components/T.astro';
import { asLocale, localePath, num, t, tf } from '~/i18n';
import { getProverbs } from '~/lib/content';
import '~/styles/lists.css';

const locale = asLocale(Astro.currentLocale);
const proverbs = await getProverbs();
---
<Base title={t(locale, 'nav.proverbs')} description="Punjabi proverbs in Shahmukhi, with literal and idiomatic English meanings.">
  <section class="column section" data-filter>
    <header class="list-head">
      <div>
        <h1><T k="nav.proverbs" /></h1>
        <p class="muted">{tf(locale, 'proverbs.count', { n: proverbs.length })}</p>
      </div>
    </header>
    {proverbs.length === 0 ? (
      <p class="empty"><T k="proverbs.empty" /></p>
    ) : (
      <>
        <div class="filter-row" data-filter-controls hidden>
          <input class="field field--wide" type="search" data-filter-input placeholder={t(locale, 'proverbs.search')} aria-label={t(locale, 'proverbs.search')} />
        </div>
        <ol class="proverb-list">
          {proverbs.map((p, i) => (
            <li class="proverb-item" data-filter-item data-filter-text={`${p.data.text} ${p.data.romanized ?? ''} ${p.data.literal_en} ${p.data.meaning_en ?? ''}`.toLowerCase()}>
              <span class="proverb-item__n">{num(locale, i + 1)}</span>
              <div>
                <a class="proverb-item__text" href={localePath(locale, `/proverbs/${p.id}`)}><Pa t={p.data.text} /></a>
                <p class="proverb-item__literal" lang="en" dir="ltr">{p.data.literal_en.replace(/\n/g, ' ')}</p>
                {p.data.meaning_en && <p class="proverb-item__meaning" lang="en" dir="ltr">{p.data.meaning_en}</p>}
              </div>
            </li>
          ))}
        </ol>
        <p class="empty" data-filter-empty hidden><T k="filter.none" /></p>
      </>
    )}
  </section>
</Base>

<script>
  import { initFilter } from '~/scripts/filter';
  initFilter();
</script>
